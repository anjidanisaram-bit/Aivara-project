# Copy this file to .env and fill in your own values. Never commit a real .env.

# Required: your OpenRouter API key. Get one at https://openrouter.ai/
OPENROUTER_API_KEY=

# Optional overrides — sensible defaults are baked into config.py.
# AIVARA_MODEL=openrouter/auto
# AIVARA_FALLBACK_MODEL=meta-llama/llama-3.1-8b-instruct:free
# AIVARA_DAILY_BUDGET=30
# AIVARA_MAX_OUTPUT_TOKENS=150
# AIVARA_BUDGET_STATE_PATH=.aivara_budget_state.json
# AIVARA_INSIGHT_CACHE_PATH=.aivara_insight_cache.json

# Simple shared-secret gate for basic-auth-style access control (v1 has no
# app-level user accounts — protect access at the network/proxy layer, or
# check this value in a reverse proxy in front of Streamlit).
# AIVARA_SHARED_SECRET=
